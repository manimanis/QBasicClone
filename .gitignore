# ========================================================
# .gitignore - QBasic Win64 & QBasic Studio
# ========================================================

# Dépendances Node.js / Web
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Fichiers objets et temporaires de compilation C/C++
*.o
*.obj
*.tmp
*.temp
*.bak

# Fichiers de dump et temporaires de tests
*.bmp.tmp
dump_*.bmp
*.log

# Fichiers système d'exploitation
Thumbs.db
Desktop.ini
.DS_Store
ehthumbs.db

# Environnements et éditeurs (VS Code, Visual Studio, JetBrains)
.vscode/
.idea/
*.suo
*.user
*.userosscache
*.sln.docstates

