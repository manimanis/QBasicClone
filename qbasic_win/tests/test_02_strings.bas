' ========================================================
' UNIT TEST 02: Strings & String Functions
' ========================================================

' 1. Concatenation et comparaison
LET a$ = "Hello"
LET b$ = " "
LET c$ = "World"
LET s$ = a$ + b$ + c$
IF (s$ = "Hello World") THEN PRINT "STR_CONCAT: PASS" ELSE PRINT "STR_CONCAT: FAIL"
IF (a$ <> c$) THEN PRINT "STR_NEQ: PASS" ELSE PRINT "STR_NEQ: FAIL"
IF ("Apple" < "Banana") THEN PRINT "STR_LT: PASS" ELSE PRINT "STR_LT: FAIL"
IF ("Zoo" > "Yak") THEN PRINT "STR_GT: PASS" ELSE PRINT "STR_GT: FAIL"

' 2. Longueur LEN
IF (LEN(s$) = 11) THEN PRINT "STR_LEN: PASS" ELSE PRINT "STR_LEN: FAIL"
IF (LEN("") = 0) THEN PRINT "STR_LEN_EMPTY: PASS" ELSE PRINT "STR_LEN_EMPTY: FAIL"

' 3. Fonctions de decoupage LEFT$, RIGHT$, MID$
IF (LEFT$("Antigravity", 4) = "Anti") THEN PRINT "STR_LEFT: PASS" ELSE PRINT "STR_LEFT: FAIL"
IF (RIGHT$("Antigravity", 7) = "gravity") THEN PRINT "STR_RIGHT: PASS" ELSE PRINT "STR_RIGHT: FAIL"
IF (MID$("Antigravity", 5, 4) = "grav") THEN PRINT "STR_MID_LEN: PASS" ELSE PRINT "STR_MID_LEN: FAIL"
IF (MID$("Antigravity", 5) = "gravity") THEN PRINT "STR_MID_REST: PASS" ELSE PRINT "STR_MID_REST: FAIL"

' 4. Casse UCASE$, LCASE$
IF (UCASE$("qbasic 1.1") = "QBASIC 1.1") THEN PRINT "STR_UCASE: PASS" ELSE PRINT "STR_UCASE: FAIL"
IF (LCASE$("HELLO WORLD") = "hello world") THEN PRINT "STR_LCASE: PASS" ELSE PRINT "STR_LCASE: FAIL"

' 5. Nettoyage d'espaces LTRIM$, RTRIM$
IF (LTRIM$("   Test") = "Test") THEN PRINT "STR_LTRIM: PASS" ELSE PRINT "STR_LTRIM: FAIL"
IF (RTRIM$("Test   ") = "Test") THEN PRINT "STR_RTRIM: PASS" ELSE PRINT "STR_RTRIM: FAIL"

' 6. Generation SPACE$, STRING$
IF (SPACE$(4) = "    ") THEN PRINT "STR_SPACE: PASS" ELSE PRINT "STR_SPACE: FAIL"
IF (STRING$(5, "*") = "*****") THEN PRINT "STR_STRING_CHAR: PASS" ELSE PRINT "STR_STRING_CHAR: FAIL"
IF (STRING$(4, 65) = "AAAA") THEN PRINT "STR_STRING_CODE: PASS" ELSE PRINT "STR_STRING_CODE: FAIL"

' 7. Codes ASCII CHR$, ASC
IF (CHR$(65) = "A") THEN PRINT "STR_CHR: PASS" ELSE PRINT "STR_CHR: FAIL"
IF (ASC("A") = 65) THEN PRINT "STR_ASC: PASS" ELSE PRINT "STR_ASC: FAIL"

' 8. Conversion STR$, VAL
LET n = 123.45
LET ns$ = STR$(n)
IF (VAL("456.78") = 456.78) THEN PRINT "STR_VAL: PASS" ELSE PRINT "STR_VAL: FAIL"
IF (VAL("100px") = 100) THEN PRINT "STR_VAL_PREFIX: PASS" ELSE PRINT "STR_VAL_PREFIX: FAIL"
IF (VAL(ns$) = 123.45) THEN PRINT "STR_ROUNDTRIP: PASS" ELSE PRINT "STR_ROUNDTRIP: FAIL"

' 9. Conversion bases HEX$, OCT$
IF (HEX$(255) = "FF") THEN PRINT "STR_HEX: PASS" ELSE PRINT "STR_HEX: FAIL"
IF (OCT$(64) = "100") THEN PRINT "STR_OCT: PASS" ELSE PRINT "STR_OCT: FAIL"

' 10. Recherche INSTR
IF (INSTR("QuickBASIC", "BASIC") = 6) THEN PRINT "STR_INSTR_2ARG: PASS" ELSE PRINT "STR_INSTR_2ARG: FAIL"
IF (INSTR(1, "QuickBASIC", "Quick") = 1) THEN PRINT "STR_INSTR_3ARG: PASS" ELSE PRINT "STR_INSTR_3ARG: FAIL"
IF (INSTR(4, "banana", "a") = 4) THEN PRINT "STR_INSTR_OFFSET: PASS" ELSE PRINT "STR_INSTR_OFFSET: FAIL"
IF (INSTR("banana", "xyz") = 0) THEN PRINT "STR_INSTR_NOTFOUND: PASS" ELSE PRINT "STR_INSTR_NOTFOUND: FAIL"
