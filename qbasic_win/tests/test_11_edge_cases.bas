' ========================================================
' UNIT TEST 11: Edge Cases & Boundary Conditions
' ========================================================

' 1. Concaténation et saturation de chaines
LET longStr$ = ""
FOR i = 1 TO 20
    longStr$ = longStr$ + "0123456789ABCDEF"
NEXT i
IF (LEN(longStr$) = 320) THEN PRINT "EDGE_STR_GROWTH: PASS" ELSE PRINT "EDGE_STR_GROWTH: FAIL"
IF (LEFT$(longStr$, 10) = "0123456789") THEN PRINT "EDGE_STR_PREFIX: PASS" ELSE PRINT "EDGE_STR_PREFIX: FAIL"
IF (RIGHT$(longStr$, 10) = "6789ABCDEF") THEN PRINT "EDGE_STR_SUFFIX: PASS" ELSE PRINT "EDGE_STR_SUFFIX: FAIL"

' 2. Comportements limites de MID$ et INSTR
LET baseStr$ = "QBasic"
IF (MID$(baseStr$, 10, 5) = "") THEN PRINT "EDGE_MID_OUT_OF_BOUNDS: PASS" ELSE PRINT "EDGE_MID_OUT_OF_BOUNDS: FAIL"
IF (MID$(baseStr$, 3, 0) = "") THEN PRINT "EDGE_MID_ZERO_LEN: PASS" ELSE PRINT "EDGE_MID_ZERO_LEN: FAIL"
IF (MID$(baseStr$, 3, 100) = "asic") THEN PRINT "EDGE_MID_EXCESS_LEN: PASS" ELSE PRINT "EDGE_MID_EXCESS_LEN: FAIL"
IF (INSTR(10, baseStr$, "a") = 0) THEN PRINT "EDGE_INSTR_BEYOND: PASS" ELSE PRINT "EDGE_INSTR_BEYOND: FAIL"

' 3. Conversions numeriques aux limites VAL et STR$
LET v_parsed = VAL("   -45.75px")
IF (v_parsed = -45.75) THEN PRINT "EDGE_VAL_SPACES_TEXT: PASS" ELSE PRINT "EDGE_VAL_SPACES_TEXT: FAIL"
LET str_neg$ = STR$(-99.5)
IF (VAL(str_neg$) = -99.5) THEN PRINT "EDGE_STR_ROUNDTRIP_NEG: PASS" ELSE PRINT "EDGE_STR_ROUNDTRIP_NEG: FAIL"

' 4. Arithmetique complexe et priorites
IF ((10 - 2 * 3) ^ 2 / 8 = 2) THEN PRINT "EDGE_MATH_PRECEDENCE_COMPLEX: PASS" ELSE PRINT "EDGE_MATH_PRECEDENCE_COMPLEX: FAIL"
IF (2 ^ -3 = 0.125) THEN PRINT "EDGE_MATH_POW_NEG: PASS" ELSE PRINT "EDGE_MATH_POW_NEG: FAIL"
IF (INT(-4.2) = -5 AND INT(-4.0) = -4) THEN PRINT "EDGE_INT_NEG: PASS" ELSE PRINT "EDGE_INT_NEG: FAIL"
IF (FIX(-4.8) = -4 AND FIX(4.8) = 4) THEN PRINT "EDGE_FIX_SYMMETRY: PASS" ELSE PRINT "EDGE_FIX_SYMMETRY: FAIL"
IF (CINT(-4.6) = -5 AND CINT(4.6) = 5) THEN PRINT "EDGE_CINT_ROUND: PASS" ELSE PRINT "EDGE_CINT_ROUND: FAIL"

' 5. Tableaux a bornes negatives
DIM negArr(-5 TO 5)
negArr(-5) = -500
negArr(0) = 0
negArr(5) = 500
IF (negArr(-5) = -500 AND negArr(0) = 0 AND negArr(5) = 500) THEN PRINT "EDGE_ARRAY_NEG_INDICES: PASS" ELSE PRINT "EDGE_ARRAY_NEG_INDICES: FAIL"
IF (LBOUND(negArr) = -5 AND UBOUND(negArr) = 5) THEN PRINT "EDGE_ARRAY_NEG_BOUNDS_1D: PASS" ELSE PRINT "EDGE_ARRAY_NEG_BOUNDS_1D: FAIL"

DIM negGrid(-2 TO 2, -3 TO 3)
negGrid(-2, -3) = 999
negGrid(2, 3) = -999
IF (negGrid(-2, -3) = 999 AND negGrid(2, 3) = -999) THEN PRINT "EDGE_ARRAY_NEG_2D: PASS" ELSE PRINT "EDGE_ARRAY_NEG_2D: FAIL"
IF (LBOUND(negGrid, 1) = -2 AND UBOUND(negGrid, 1) = 2) THEN PRINT "EDGE_ARRAY_NEG_BOUNDS_2D_1: PASS" ELSE PRINT "EDGE_ARRAY_NEG_BOUNDS_2D_1: FAIL"
IF (LBOUND(negGrid, 2) = -3 AND UBOUND(negGrid, 2) = 3) THEN PRINT "EDGE_ARRAY_NEG_BOUNDS_2D_2: PASS" ELSE PRINT "EDGE_ARRAY_NEG_BOUNDS_2D_2: FAIL"

' 6. Comparaisons de chaines aux limites
IF ("" < "A") THEN PRINT "EDGE_STR_EMPTY_LT: PASS" ELSE PRINT "EDGE_STR_EMPTY_LT: FAIL"
IF ("abc" < "abcd") THEN PRINT "EDGE_STR_PREFIX_LT: PASS" ELSE PRINT "EDGE_STR_PREFIX_LT: FAIL"
IF ("Beta" > "Alpha") THEN PRINT "EDGE_STR_GT: PASS" ELSE PRINT "EDGE_STR_GT: FAIL"

PRINT "EDGE_CASES_ALL: PASS"
