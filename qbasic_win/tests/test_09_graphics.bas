' ========================================================
' UNIT TEST 09: Graphics (SCREEN, CLS, COLOR, PSET, PRESET, LINE, CIRCLE, POINT, GET, PUT)
' ========================================================

' 1. Initialisation SCREEN 13 (320x200, 256 couleurs)
SCREEN 13
PRINT "GRAPHICS_SCREEN_13: PASS"

' 2. CLS et COLOR
COLOR 15
CLS
PRINT "GRAPHICS_CLS_COLOR: PASS"

' 3. PSET et POINT
PSET (50, 50), 12
LET col_read = POINT(50, 50)
IF (col_read = 12) THEN PRINT "GRAPHICS_PSET_POINT: PASS" ELSE PRINT "GRAPHICS_PSET_POINT: FAIL"

' 4. PRESET (reinitialise a la couleur d'arriere-plan, par defaut 0)
PRESET (50, 50)
LET col_preset = POINT(50, 50)
IF (col_preset = 0) THEN PRINT "GRAPHICS_PRESET: PASS" ELSE PRINT "GRAPHICS_PRESET: FAIL"

' 5. Ligne simple LINE
LINE (10, 10)-(20, 10), 14
IF (POINT(15, 10) = 14) THEN PRINT "GRAPHICS_LINE_SIMPLE: PASS" ELSE PRINT "GRAPHICS_LINE_SIMPLE: FAIL"

' 6. Rectangle vide LINE ..., B
LINE (30, 30)-(40, 40), 9, B
IF (POINT(30, 30) = 9 AND POINT(35, 35) = 0) THEN PRINT "GRAPHICS_LINE_BOX: PASS" ELSE PRINT "GRAPHICS_LINE_BOX: FAIL"

' 7. Rectangle plein LINE ..., BF
LINE (60, 60)-(70, 70), 10, BF
IF (POINT(65, 65) = 10) THEN PRINT "GRAPHICS_LINE_BOX_FILL: PASS" ELSE PRINT "GRAPHICS_LINE_BOX_FILL: FAIL"

' 8. Cercle CIRCLE
CIRCLE (100, 100), 15, 13
IF (POINT(100, 85) = 13) THEN PRINT "GRAPHICS_CIRCLE: PASS" ELSE PRINT "GRAPHICS_CIRCLE: FAIL"

' 9. Capture et restitution de sprite : GET et PUT
DIM sprite(100)
GET (60, 60)-(65, 65), sprite
PUT (120, 120), sprite, PSET
IF (POINT(122, 122) = 10) THEN PRINT "GRAPHICS_GET_PUT: PASS" ELSE PRINT "GRAPHICS_GET_PUT: FAIL"

' 10. Retour en mode texte SCREEN 0
SCREEN 0
PRINT "GRAPHICS_SCREEN_0: PASS"

PRINT "GRAPHICS_ALL: PASS"
