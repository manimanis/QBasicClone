' ========================================================
' UNIT TEST 01: Math, Arithmetic Operators & Functions
' ========================================================

' 1. Operations arithmetiques de base
IF (10 + 5 = 15) THEN PRINT "MATH_ADD: PASS" ELSE PRINT "MATH_ADD: FAIL"
IF (20 - 7 = 13) THEN PRINT "MATH_SUB: PASS" ELSE PRINT "MATH_SUB: FAIL"
IF (6 * 7 = 42) THEN PRINT "MATH_MUL: PASS" ELSE PRINT "MATH_MUL: FAIL"
IF (100 / 4 = 25) THEN PRINT "MATH_DIV_FLOAT: PASS" ELSE PRINT "MATH_DIV_FLOAT: FAIL"
IF (17 \ 5 = 3) THEN PRINT "MATH_DIV_INT: PASS" ELSE PRINT "MATH_DIV_INT: FAIL"
IF (17 MOD 5 = 2) THEN PRINT "MATH_MOD: PASS" ELSE PRINT "MATH_MOD: FAIL"
IF (2 ^ 8 = 256) THEN PRINT "MATH_POW: PASS" ELSE PRINT "MATH_POW: FAIL"

' 2. Priorites et parenthesages
IF (2 + 3 * 4 = 14) THEN PRINT "MATH_PRECEDENCE_1: PASS" ELSE PRINT "MATH_PRECEDENCE_1: FAIL"
IF ((2 + 3) * 4 = 20) THEN PRINT "MATH_PRECEDENCE_PARENS: PASS" ELSE PRINT "MATH_PRECEDENCE_PARENS: FAIL"
IF (-5 + 10 = 5) THEN PRINT "MATH_UNARY_MINUS: PASS" ELSE PRINT "MATH_UNARY_MINUS: FAIL"
IF (+12 = 12) THEN PRINT "MATH_UNARY_PLUS: PASS" ELSE PRINT "MATH_UNARY_PLUS: FAIL"

' 3. Fonctions mathematiques standard
IF (ABS(-42) = 42 AND ABS(42) = 42) THEN PRINT "MATH_ABS: PASS" ELSE PRINT "MATH_ABS: FAIL"
IF (SQR(144) = 12) THEN PRINT "MATH_SQR: PASS" ELSE PRINT "MATH_SQR: FAIL"
IF (INT(3.7) = 3 AND INT(-3.2) = -4) THEN PRINT "MATH_INT: PASS" ELSE PRINT "MATH_INT: FAIL"
IF (FIX(3.7) = 3 AND FIX(-3.7) = -3) THEN PRINT "MATH_FIX: PASS" ELSE PRINT "MATH_FIX: FAIL"
IF (CINT(4.6) = 5 AND CINT(4.2) = 4) THEN PRINT "MATH_CINT: PASS" ELSE PRINT "MATH_CINT: FAIL"
IF (SGN(-10) = -1 AND SGN(0) = 0 AND SGN(25) = 1) THEN PRINT "MATH_SGN: PASS" ELSE PRINT "MATH_SGN: FAIL"

' 4. Trigonometrie & Transcendantes
IF (COS(0) = 1) THEN PRINT "MATH_COS_ZERO: PASS" ELSE PRINT "MATH_COS_ZERO: FAIL"
IF (SIN(0) = 0) THEN PRINT "MATH_SIN_ZERO: PASS" ELSE PRINT "MATH_SIN_ZERO: FAIL"
IF (INT(TAN(0)) = 0) THEN PRINT "MATH_TAN_ZERO: PASS" ELSE PRINT "MATH_TAN_ZERO: FAIL"
IF (INT(ATN(0)) = 0) THEN PRINT "MATH_ATN_ZERO: PASS" ELSE PRINT "MATH_ATN_ZERO: FAIL"
IF (INT(EXP(0)) = 1) THEN PRINT "MATH_EXP_ZERO: PASS" ELSE PRINT "MATH_EXP_ZERO: FAIL"
IF (INT(LOG(EXP(1))) = 1) THEN PRINT "MATH_LOG_NATURAL: PASS" ELSE PRINT "MATH_LOG_NATURAL: FAIL"

' 5. Operateurs logiques bit-a-bit
IF ((5 AND 3) = 1) THEN PRINT "MATH_BIT_AND: PASS" ELSE PRINT "MATH_BIT_AND: FAIL"
IF ((5 OR 2) = 7) THEN PRINT "MATH_BIT_OR: PASS" ELSE PRINT "MATH_BIT_OR: FAIL"
IF ((5 XOR 3) = 6) THEN PRINT "MATH_BIT_XOR: PASS" ELSE PRINT "MATH_BIT_XOR: FAIL"
IF (NOT 0 = -1) THEN PRINT "MATH_BIT_NOT: PASS" ELSE PRINT "MATH_BIT_NOT: FAIL"

' 6. Nombres aleatoires RND & RANDOMIZE
LET r = RND
IF (r >= 0 AND r < 1) THEN PRINT "MATH_RND: PASS" ELSE PRINT "MATH_RND: FAIL"
RANDOMIZE 54321
PRINT "MATH_RANDOMIZE: PASS"

' 7. Litteraux hexadecimaux et octaux
IF (&H10 = 16) THEN PRINT "MATH_HEX_LITERAL: PASS" ELSE PRINT "MATH_HEX_LITERAL: FAIL"
IF (&HFF = 255) THEN PRINT "MATH_HEX_LITERAL_FF: PASS" ELSE PRINT "MATH_HEX_LITERAL_FF: FAIL"
