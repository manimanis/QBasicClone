' ========================================================
' UNIT TEST 03: Variables, Suffixes, Arrays & User Types
' ========================================================

' 1. Suffixes de types
LET i% = 32767
LET l& = 2147483647
LET s! = 3.14
LET d# = 2.718281828459
LET str$ = "QBasic"

IF (i% = 32767) THEN PRINT "VAR_SUFFIX_INT: PASS" ELSE PRINT "VAR_SUFFIX_INT: FAIL"
IF (l& = 2147483647) THEN PRINT "VAR_SUFFIX_LONG: PASS" ELSE PRINT "VAR_SUFFIX_LONG: FAIL"
IF (INT(s! * 100) = 314) THEN PRINT "VAR_SUFFIX_SINGLE: PASS" ELSE PRINT "VAR_SUFFIX_SINGLE: FAIL"
IF (d# > 2.71 AND d# < 2.72) THEN PRINT "VAR_SUFFIX_DOUBLE: PASS" ELSE PRINT "VAR_SUFFIX_DOUBLE: FAIL"
IF (str$ = "QBasic") THEN PRINT "VAR_SUFFIX_STR: PASS" ELSE PRINT "VAR_SUFFIX_STR: FAIL"

' 2. CONSTANTES
CONST C_INT = 42
CONST C_STR = "ConstantValue"
IF (C_INT = 42) THEN PRINT "CONST_NUM: PASS" ELSE PRINT "CONST_NUM: FAIL"
IF (C_STR = "ConstantValue") THEN PRINT "CONST_STR: PASS" ELSE PRINT "CONST_STR: FAIL"

' 3. SWAP
LET x1 = 10
LET x2 = 20
SWAP x1, x2
IF (x1 = 20 AND x2 = 10) THEN PRINT "SWAP_NUM: PASS" ELSE PRINT "SWAP_NUM: FAIL"

LET s1$ = "AAA"
LET s2$ = "BBB"
SWAP s1$, s2$
IF (s1$ = "BBB" AND s2$ = "AAA") THEN PRINT "SWAP_STR: PASS" ELSE PRINT "SWAP_STR: FAIL"

' 4. TABLEAUX (1D et 2D, avec LBOUND et UBOUND)
DIM arr1(10)
arr1(0) = 100
arr1(10) = 200
IF (arr1(0) = 100 AND arr1(10) = 200) THEN PRINT "ARRAY_1D_DEFAULT: PASS" ELSE PRINT "ARRAY_1D_DEFAULT: FAIL"
IF (LBOUND(arr1) = 0 AND UBOUND(arr1) = 10) THEN PRINT "ARRAY_BOUNDS_DEFAULT: PASS" ELSE PRINT "ARRAY_BOUNDS_DEFAULT: FAIL"

DIM arr_range(5 TO 15)
arr_range(5) = 55
arr_range(15) = 155
IF (arr_range(5) = 55 AND arr_range(15) = 155) THEN PRINT "ARRAY_1D_RANGE: PASS" ELSE PRINT "ARRAY_1D_RANGE: FAIL"
IF (LBOUND(arr_range) = 5 AND UBOUND(arr_range) = 15) THEN PRINT "ARRAY_BOUNDS_RANGE: PASS" ELSE PRINT "ARRAY_BOUNDS_RANGE: FAIL"

DIM mat(1 TO 3, 1 TO 4)
mat(1, 1) = 11
mat(3, 4) = 34
IF (mat(1, 1) = 11 AND mat(3, 4) = 34) THEN PRINT "ARRAY_2D: PASS" ELSE PRINT "ARRAY_2D: FAIL"
IF (LBOUND(mat, 1) = 1 AND UBOUND(mat, 1) = 3) THEN PRINT "ARRAY_2D_BOUNDS_1: PASS" ELSE PRINT "ARRAY_2D_BOUNDS_1: FAIL"
IF (LBOUND(mat, 2) = 1 AND UBOUND(mat, 2) = 4) THEN PRINT "ARRAY_2D_BOUNDS_2: PASS" ELSE PRINT "ARRAY_2D_BOUNDS_2: FAIL"

ERASE arr1
IF (arr1(0) = 0) THEN PRINT "ARRAY_ERASE: PASS" ELSE PRINT "ARRAY_ERASE: FAIL"

' 5. TYPES UTILISATEUR (TYPE ... END TYPE)
TYPE Point2D
    x AS INTEGER
    y AS INTEGER
END TYPE

DIM pt AS Point2D
pt.x = 120
pt.y = 240
IF (pt.x = 120 AND pt.y = 240) THEN PRINT "TYPE_SCALAR: PASS" ELSE PRINT "TYPE_SCALAR: FAIL"

DIM pts(1 TO 3) AS Point2D
pts(1).x = 10
pts(1).y = 20
pts(2).x = 30
pts(2).y = 40
IF (pts(1).x = 10 AND pts(1).y = 20 AND pts(2).x = 30 AND pts(2).y = 40) THEN PRINT "TYPE_ARRAY: PASS" ELSE PRINT "TYPE_ARRAY: FAIL"
